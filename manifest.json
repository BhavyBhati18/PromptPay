{
  "manifest_version": 3,
  "name": "QueryPay - ChatGPT & Gemini Rewards",
  "version": "1.0.0",
  "description": "Earn $0.0003 for every search on ChatGPT and Gemini. Withdraw at $10.00. Companies can list sponsored ads.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QueryPay Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "options_ui": {
    "page": "advertiser_portal.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://gemini.google.com/*",
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "advertiser_portal.html",
        "ad_engine.js",
        "icons/*"
      ],
      "matches": ["*://chatgpt.com/*", "*://chat.openai.com/*", "*://gemini.google.com/*"]
    }
  ]
}
